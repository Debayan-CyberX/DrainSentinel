# DrainSentinel — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────
APP_NAME=DrainSentinel
APP_VERSION=0.1.0
DEBUG=false

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AWS (future cloud deployment) ────────────────────────────
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME
# DYNAMODB_TABLE_DRAINS=drain-sentinel-drains
# DYNAMODB_TABLE_REPORTS=drain-sentinel-reports
# DYNAMODB_TABLE_TASKS=drain-sentinel-tasks
# S3_BUCKET_PHOTOS=drain-sentinel-photos
# SNS_TOPIC_ALERTS=arn:aws:sns:ap-south-1:123456789012:drain-sentinel-alerts

# ── Auth (future) ────────────────────────────────────────────
# JWT_SECRET=REPLACE_ME
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
